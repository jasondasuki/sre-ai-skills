{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kubernetes cost review evidence v1",
  "type": "object",
  "required": ["schema_version", "scope", "collected_at", "review_started_at", "outputs", "report_checks", "window", "pricing", "sources", "observations", "findings", "scenarios", "gaps"],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {
      "type": "object", "required": ["contexts", "namespaces", "mode"],
      "properties": {
        "contexts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "namespaces": {"type": "array", "items": {"type": "string"}},
        "mode": {"enum": ["live", "supplied"]}
      }
    },
    "collected_at": {"type": ["string", "null"]},
    "review_started_at": {"type": "string", "minLength": 1},
    "outputs": {
      "type": "object", "required": ["markdown", "html", "evidence"],
      "properties": {"markdown": {"type": ["string", "null"]}, "html": {"type": ["string", "null"]}, "evidence": {"type": ["string", "null"]}}
    },
    "report_checks": {
      "type": "object", "required": ["markup", "visual", "limitations"],
      "properties": {"markup": {"type": ["string", "null"]}, "visual": {"type": ["string", "null"]}, "limitations": {"type": "array", "items": {"type": "string"}}}
    },
    "window": {
      "type": "object", "required": ["start", "end", "coverage_notes"],
      "properties": {"start": {"type": ["string", "null"]}, "end": {"type": ["string", "null"]}, "coverage_notes": {"type": "array", "items": {"type": "string"}}}
    },
    "pricing": {
      "type": "object", "required": ["currency", "basis", "rate_source", "rate_date", "period"],
      "properties": {
        "currency": {"type": ["string", "null"]}, "basis": {"enum": ["marginal", "list", "amortized", null]},
        "rate_source": {"type": ["string", "null"]}, "rate_date": {"type": ["string", "null"]}, "period": {"type": ["string", "null"]}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["name", "status", "reason"],
      "properties": {"name": {"type": "string", "minLength": 1}, "status": {"enum": ["available", "unavailable", "partial"]}, "reason": {"type": ["string", "null"]}}
    }},
    "observations": {"type": "array", "items": {
      "type": "object", "required": ["id", "resource", "source", "query_or_reference", "timestamp", "aggregation", "value", "unit", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "resource": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}, "query_or_reference": {"type": "string", "minLength": 1},
        "timestamp": {"type": ["string", "null"]}, "aggregation": {"type": ["string", "null"]},
        "unit": {"type": ["string", "null"]}, "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }},
    "findings": {"type": "array", "items": {
      "type": "object", "required": ["id", "readiness", "target", "action", "evidence_ids", "dependencies", "overlap_group", "saving", "capacity_benefit", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "readiness": {"enum": ["ready", "conditional", "measure-first", "rejected"]},
        "target": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}}, "overlap_group": {"type": ["string", "null"]},
        "saving": {"type": "object", "required": ["low", "high", "currency", "period", "basis", "formula", "assumptions"],
          "properties": {"low": {"type": ["number", "null"]}, "high": {"type": ["number", "null"]},
            "currency": {"type": ["string", "null"]}, "period": {"type": "string"}, "basis": {"enum": ["marginal", "list", "amortized", null]},
            "formula": {"type": ["string", "null"]}, "assumptions": {"type": "array", "items": {"type": "string"}}}},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }},
    "scenarios": {"type": "array", "items": {
      "type": "object", "required": ["id", "action_ids", "baseline", "proposed", "saving", "baseline_components", "proposed_components", "assumptions"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "action_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "baseline": {"type": ["number", "null"]}, "proposed": {"type": ["number", "null"]}, "saving": {"type": ["number", "null"]},
        "baseline_components": {"type": "array", "items": {"type": "object"}}, "proposed_components": {"type": "array", "items": {"type": "object"}},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    }},
    "gaps": {"type": "array", "items": {"type": "string"}}
  }
}
